---
import Base from "../../layouts/Base.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import { projects, type Project } from "../../content/profile";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
---
<Base title={`${p.name} · Piyush Mohapatra`} description={p.line}>
  <CaseStudy name={p.name} kind={p.kind} year={p.year} status={p.status} line={p.line} stack={p.stack} links={p.links}>
    {p.body.map((para) => <p>{para}</p>)}
  </CaseStudy>
</Base>
