---
import Kinetic from "./Kinetic.astro";
import { links, person } from "../content/profile";
---
<section class="section contact" id="contact" aria-labelledby="contact-h">
  <canvas class="terrain" data-contour="contact" aria-hidden="true"></canvas>
  <div class="wrap">
    <div class="section-head">
      <span class="label">Contact</span>
      <h2 id="contact-h" class="sr-only">Contact</h2>
    </div>
    <p class="big"><Kinetic text="SAY HELLO" /></p>
    <ul class="links">
      {links.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener noreferrer me" data-track={`out:contact:${l.label}`}>
            <span class="lb">{l.label}</span><span class="mono hd">{l.handle} ↗</span>
          </a>
        </li>
      ))}
      {person.email && (
        <li class="mail">
          <a href={`mailto:${person.email}`} data-track="out:contact:email"><span class="lb">Email</span><span class="mono hd">{person.email}</span></a>
        </li>
      )}
    </ul>
  </div>
</section>

<style>
  .contact { position: relative; isolation: isolate; overflow: hidden; padding-bottom: clamp(40px, 6vw, 80px); }
  .terrain { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.8; }
  .big { font-size: min(var(--step-4), 14vw); font-weight: 850; line-height: 0.82; letter-spacing: -0.035em; cursor: crosshair; user-select: none; }
  .links { list-style: none; margin: clamp(40px, 6vw, 80px) 0 0; padding: 0; border-top: 2px solid var(--ink); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 40px; }
  .links li { border-bottom: 1px solid var(--line); }
  .links a { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 18px 0; text-decoration: none; }
  .lb { font-size: var(--step-2); font-weight: 800; letter-spacing: -0.02em; transition: font-stretch 0.4s var(--ease); }
  .links a:hover .lb { font-stretch: 125%; }
  .hd { color: var(--muted); text-align: right; min-width: 0; }

  @media (max-width: 860px) { .links { grid-template-columns: 1fr; } }
</style>
