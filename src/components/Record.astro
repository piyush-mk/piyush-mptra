---
import { Image, getImage } from "astro:assets";
import { achievements } from "../content/profile";
import metaPytorch from "../assets/hack/meta-pytorch.jpg";
import paytm from "../assets/hack/paytm.jpg";
import pocketfm from "../assets/hack/pocketfm.jpg";
import goldman from "../assets/hack/goldman.jpg";
import nasa from "../assets/hack/nasa.jpg";
import hacknitr from "../assets/hack/hacknitr.jpg";

const images = { "meta-pytorch": metaPytorch, paytm, pocketfm, goldman, nasa, hacknitr };
// Large version for the click-to-enlarge viewer
const full = Object.fromEntries(
  await Promise.all(Object.entries(images).map(async ([k, src]) => [k, (await getImage({ src, width: 1200, format: "webp" })).src])),
);
---
<section class="section" id="record" aria-labelledby="rec-h">
  <div class="wrap">
    <div class="section-head">
      <span class="label">Hackathons</span>
      <h2 id="rec-h">Results</h2>
    </div>
    <ol class="ranks">
      {achievements.map((a) => (
        <li>
          {a.img ? (
            <button class="thumb" type="button" data-lightbox={full[a.img]} data-alt={`Photos from the ${a.event}`} aria-label={`Enlarge photos from the ${a.event}`}>
              <Image src={images[a.img]} alt="" widths={[240, 480, 800]} sizes="(max-width: 600px) 92vw, 200px" />
            </button>
          ) : (
            <span class="thumb empty mono" aria-hidden="true">{a.date}</span>
          )}
          <div class="txt">
            <span class="rank">{a.rank}</span>
            <span class="ev">{a.event}</span>
            <span class="mono dt">{a.date}</span>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <dialog class="lightbox" data-lightbox-dialog aria-label="Hackathon photos">
    <img alt="" data-lightbox-img />
    <button class="close mono" type="button" data-lightbox-close>Close</button>
  </dialog>
</section>

<style>
  .ranks { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; }
  .ranks li { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 20px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .thumb { display: block; padding: 0; border: 0; border-radius: 4px; overflow: hidden; aspect-ratio: 4 / 3; max-width: 100%; background: var(--paper-2); cursor: zoom-in; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s var(--ease); }
  .thumb:hover :global(img) { transform: scale(1.04); }
  .thumb.empty { display: grid; place-items: center; color: var(--muted); cursor: default; border: 1px dashed var(--line); background: transparent; }
  .txt { display: grid; gap: 6px; align-content: center; }
  .rank { font-size: var(--step-1); font-weight: 850; font-stretch: 108%; letter-spacing: -0.01em; line-height: 1.1; transition: color 0.2s, font-stretch 0.4s var(--ease); }
  .ranks li:hover .rank { color: var(--accent); font-stretch: 125%; }
  .ev { font-size: 15px; line-height: 1.3; }
  .dt { color: var(--muted); }

  .lightbox { padding: 0; border: 0; background: transparent; max-width: min(1200px, 94vw); max-height: 90vh; overflow: visible; }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.78); }
  .lightbox img { display: block; max-width: 100%; max-height: 82vh; width: auto; height: auto; border-radius: 6px; }
  .close { position: absolute; right: 0; top: -40px; background: transparent; color: #fff; border: 1px solid rgb(255 255 255 / 0.5); border-radius: 999px; padding: 4px 14px; cursor: pointer; }

  @media (max-width: 1000px) { .ranks { grid-template-columns: 1fr; } }
  @media (max-width: 600px) {
    .ranks li { grid-template-columns: 1fr; gap: 12px; }
    .thumb.empty { display: none; }
  }
</style>
