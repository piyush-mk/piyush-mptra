---
import { Image } from "astro:assets";
import { projects } from "../content/profile";
import advaita from "../assets/shots/advaita.jpg";
import invoiceguard from "../assets/shots/invoiceguard.jpg";
import agent from "../assets/shots/agent.jpg";
import awaaz from "../assets/shots/awaaz.jpg";

const shots = { advaita, invoiceguard, agent, awaaz };
const list = projects.filter((p) => p.featured);
const host = (p: (typeof list)[number]) => p.links[0]?.href.replace(/^https?:\/\//, "").replace(/\/$/, "") ?? `${p.slug}.local`;
---
<section class="section" id="projects" aria-labelledby="proj-h">
  <div class="wrap">
    <div class="section-head">
      <span class="label">Projects</span>
      <h2 id="proj-h">Things I've shipped</h2>
    </div>

    <div class="desk" data-desk>
      {list.map((p, i) => (
        <article class={`win w${i}`} data-win={p.slug} aria-labelledby={`win-${p.slug}`}>
          <header class="bar mono" data-drag>
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="t">{host(p)}</span>
            {p.status && <span class="st">{p.status}</span>}
          </header>

          {p.shot ? (
            <a class="shot" href={`/work/${p.slug}`} tabindex="-1" aria-hidden="true">
              <Image src={shots[p.shot]} alt="" widths={[480, 800, 1200]} sizes="(max-width: 680px) 92vw, (max-width: 1180px) 46vw, 40vw" />
              {p.illustration && <span class="tag mono">Illustration</span>}
            </a>
          ) : (
            <pre class="art mono" aria-hidden="true">{`company   Visa          year   2023
analysis  Consumer credit

mode      single year | 5-year trend

10-K  ▸ parse ▸ clean ▸ index ▸ LLM read`}</pre>
          )}

          <div class="body">
            <h3 id={`win-${p.slug}`}><a href={`/work/${p.slug}`}>{p.name}</a></h3>
            <p class="line">{p.line}</p>
            <p class="meta mono">
              <span>{p.stack.slice(0, 3).join(" · ")}</span>
              {p.links[0] && <a href={p.links[0].href} target="_blank" rel="noopener noreferrer" data-track={`out:${p.slug}:${p.links[0].label}`}>Visit ↗</a>}
            </p>
          </div>
        </article>
      ))}

      <div class="cursor" data-cursor aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M3 2l7 19 2.5-7.5L20 11z"></path></svg>
        <span class="mono" data-cursor-label>agent</span>
      </div>
    </div>
  </div>
</section>

<style>
  .desk {
    position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 20px; padding: 24px;
    border: 1px solid var(--line); border-radius: 6px; background-color: var(--paper-2);
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 12%, transparent) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .w0 { grid-column: 1 / span 7; }
  .w1 { grid-column: 8 / span 5; align-self: start; }
  .w2 { grid-column: 1 / span 4; align-self: start; }
  .w3 { grid-column: 5 / span 3; align-self: start; }
  .w4 { grid-column: 8 / span 5; grid-row: 2; align-self: start; }
  .w2, .w3 { grid-row: 2; }

  .win {
    position: relative; display: flex; flex-direction: column; min-width: 0; background: var(--window); border: 1px solid var(--line); border-radius: 8px;
    box-shadow: 0 18px 40px -28px rgb(0 0 0 / 0.4); outline: 2px solid transparent; transition: outline-color 0.3s, box-shadow 0.3s;
  }
  .win.focus { outline-color: var(--accent); box-shadow: 0 26px 60px -28px rgb(0 0 0 / 0.45); }
  .bar { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-bottom: 1px solid var(--line); color: var(--muted); cursor: grab; user-select: none; touch-action: none; min-width: 0; }
  .bar:active { cursor: grabbing; }
  .dots { display: flex; gap: 5px; flex: none; }
  .dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--line); }
  .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .st { margin-left: auto; color: var(--accent); white-space: nowrap; }

  .shot { position: relative; display: block; aspect-ratio: 16 / 10; max-width: 100%; overflow: hidden; background: #0b0f14; border-bottom: 1px solid var(--line); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.8s var(--ease); }
  .win:hover .shot :global(img) { transform: scale(1.02); }
  .tag { position: absolute; right: 10px; bottom: 10px; background: color-mix(in srgb, var(--window) 88%, transparent); color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 2px 9px; font-size: 11px; }
  .art { margin: 0; padding: 18px; background: var(--paper-2); border-bottom: 1px solid var(--line); min-height: 150px; font-size: 12.5px; line-height: 1.7; color: var(--ink); overflow-x: auto; }

  .body { padding: 14px 16px 16px; display: grid; gap: 6px; }
  h3 { font-size: 26px; font-weight: 850; letter-spacing: -0.02em; line-height: 1; transition: font-stretch 0.4s var(--ease); }
  h3 a { text-decoration: none; }
  .win:hover h3, .win.focus h3 { font-stretch: 118%; }
  .line { color: var(--muted); font-size: 15px; line-height: 1.4; }
  .meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; color: var(--muted); margin-top: 4px; }
  .meta a { color: var(--accent); text-decoration: none; white-space: nowrap; }

  .cursor { position: absolute; left: 0; top: 0; z-index: 30; width: 22px; height: 22px; pointer-events: none; transition: transform 1.2s cubic-bezier(0.6, 0, 0.2, 1), opacity 0.4s; }
  .cursor svg { width: 22px; height: 22px; filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.3)); }
  .cursor path { fill: var(--accent); stroke: var(--window); stroke-width: 1.5; }
  .cursor span { position: absolute; left: 18px; top: 18px; background: var(--accent); color: var(--accent-ink); padding: 1px 6px; border-radius: 4px; white-space: nowrap; font-size: 11px; }
  .desk.user .cursor { opacity: 0; }

  @media (max-width: 1180px) {
    .w0, .w1, .w2, .w3, .w4 { grid-column: span 6; grid-row: auto; }
    .w0 { grid-column: 1 / -1; }
    .cursor { display: none; }
    .bar { cursor: default; }
  }
  @media (max-width: 680px) {
    .desk { padding: 12px; gap: 14px; }
    .w0, .w1, .w2, .w3, .w4 { grid-column: 1 / -1; }
  }
</style>
