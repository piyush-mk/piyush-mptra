---
import { experience, education, stack } from "../content/profile";
---
<section class="section" id="experience" aria-labelledby="exp-h">
  <div class="wrap">
    <div class="section-head">
      <span class="label">Experience</span>
      <h2 id="exp-h">Where I've worked</h2>
    </div>
    <ul class="roles">
      {experience.map((r) => (
        <li>
          <span class="mono yr">{r.years}</span>
          <span class="org">{r.org}</span>
          <span class="title">{r.title}</span>
          <span class="line">{r.line}</span>
        </li>
      ))}
      <li class="edu">
        <span class="mono yr">{education.years}</span>
        <span class="org">Manipal</span>
        <span class="title">{education.degree}</span>
        <span class="line">{education.school}</span>
      </li>
    </ul>
    <p class="stack mono"><span class="label">Stack</span> {stack.join(" · ")}</p>
  </div>
</section>

<style>
  .roles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .roles li { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 4px 16px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .yr { grid-column: span 3; color: var(--muted); }
  .org { grid-column: span 3; font-size: var(--step-1); font-weight: 800; letter-spacing: -0.01em; transition: font-stretch 0.4s var(--ease), color 0.2s; }
  .roles li:hover .org { font-stretch: 120%; color: var(--accent); }
  .title { grid-column: span 2; font-weight: 600; font-stretch: 92%; font-size: 15px; }
  .line { grid-column: span 4; color: var(--muted); font-size: 15px; }
  .edu .org { font-weight: 600; }
  .stack { margin-top: 20px; color: var(--muted); display: flex; gap: 12px; flex-wrap: wrap; align-items: baseline; }
  @media (max-width: 900px) {
    .yr, .org, .title, .line { grid-column: 1 / -1; }
  }
</style>
