---
import { experience, education, stack } from "../content/profile";
---
<section class="section" id="experience" aria-labelledby="exp-h">
  <div class="wrap">
    <div class="section-head">
      <span class="label">Experience</span>
      <h2 id="exp-h">Where I've worked</h2>
    </div>
    <ul class="roles">
      {experience.map((r) => (
        <li>
          <span class="mono yr">{r.years}</span>
          <div class="who">
            <span class="org">{r.org}</span>
            <span class="title">{r.title}</span>
          </div>
          <ul class="points">
            {r.points.map((p) => <li>{p}</li>)}
          </ul>
        </li>
      ))}
      <li class="edu">
        <span class="mono yr">{education.years}</span>
        <div class="who">
          <span class="org">Manipal</span>
          <span class="title">{education.degree}</span>
        </div>
        <ul class="points"><li>{education.school}</li></ul>
      </li>
    </ul>
    <p class="stack mono"><span class="label">Stack</span> {stack.join(" · ")}</p>
  </div>
</section>

<style>
  .roles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .roles > li { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 8px 16px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .yr { grid-column: span 2; color: var(--muted); }
  .who { grid-column: span 4; display: grid; gap: 2px; }
  .org { font-size: var(--step-1); font-weight: 800; letter-spacing: -0.01em; transition: font-stretch 0.4s var(--ease), color 0.2s; }
  .roles > li:hover .org { font-stretch: 120%; color: var(--accent); }
  .title { font-weight: 500; font-stretch: 92%; font-size: 15px; color: var(--muted); }
  .points { grid-column: span 6; list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 15px; line-height: 1.45; }
  .points li { position: relative; padding-left: 18px; max-width: 62ch; }
  .points li::before { content: ""; position: absolute; left: 0; top: 0.72em; width: 8px; height: 1px; background: var(--accent); }
  .edu .org { font-weight: 600; }
  .stack { margin-top: 20px; color: var(--muted); display: flex; gap: 12px; flex-wrap: wrap; align-items: baseline; }
  @media (max-width: 900px) {
    .yr, .who, .points { grid-column: 1 / -1; }
    .points { margin-top: 6px; }
  }
</style>
