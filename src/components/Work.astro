---
import Kinetic from "./Kinetic.astro";
import { portbot } from "../content/profile";
---
<section class="section" id="work" aria-labelledby="work-h">
  <div class="wrap">
    <div class="section-head">
      <span class="label">At work · BlackRock</span>
      <h2 id="work-h">PortBot</h2>
    </div>
    <div class="row">
      <p class="serif lede">{portbot.line}</p>
      <dl class="metrics">
        {portbot.metrics.map((m) => (
          <div class="m">
            <dd><Kinetic text={m.value} class="num" /></dd>
            <dt class="label">{m.label}</dt>
          </div>
        ))}
      </dl>
    </div>
    <a class="more mono" href="/work/portbot">How it works →</a>
  </div>
</section>

<style>
  .row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; align-items: end; }
  .lede { grid-column: 4 / span 4; font-size: var(--step-1); line-height: 1.35; }
  .metrics { grid-column: 8 / -1; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .m { display: grid; gap: 8px; border-top: 1px solid var(--ink); padding-top: 12px; }
  .m dd { margin: 0; font-size: var(--step-2); font-weight: 850; line-height: 0.9; letter-spacing: -0.02em; }
  .more { display: inline-block; margin-top: 28px; margin-left: calc((100% + 16px) / 12 * 3); text-decoration: none; color: var(--accent); }
  @media (max-width: 900px) {
    .lede, .metrics { grid-column: 1 / -1; }
    .more { margin-left: 0; }
  }
</style>
