---
import Kinetic from "./Kinetic.astro";
import { portbot } from "../content/profile";
---
<section class="section" id="work" aria-labelledby="work-h">
  <div class="wrap">
    <div class="section-head">
      <span class="label">Selected work · BlackRock</span>
      <h2 id="work-h">PortBot turns a sentence into a validated portfolio.</h2>
    </div>

    <div class="intro">
      <p class="serif lede">Setting up a portfolio used to mean forms, lookups and back-and-forth across teams. Now an operations user types what they want. PortBot is an LLM agent built like software rather than a prompt: the model proposes, deterministic code decides.</p>
      <a class="more mono" href="/work/portbot">Read the case study →</a>
    </div>

    <dl class="metrics">
      {portbot.metrics.map((m) => (
        <div class="m reveal">
          <dt class="label">{m.label}</dt>
          <dd><Kinetic text={m.value} class="num" /></dd>
        </div>
      ))}
    </dl>

    <ol class="steps">
      {portbot.steps.map((s, i) => (
        <li class="reveal">
          <span class="mono idx">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.name}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="mono stack">{portbot.stack.join("  /  ")}</p>
  </div>
</section>

<style>
  .intro { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; align-items: end; }
  .lede { grid-column: 4 / span 7; font-size: var(--step-1); line-height: 1.35; }
  .more { grid-column: 11 / -1; justify-self: end; text-decoration: none; color: var(--accent); }
  .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: clamp(48px, 6vw, 96px) 0 0; border-top: 1px solid var(--ink); }
  .m { padding: 14px 16px 0 0; border-right: 1px solid var(--line); }
  .m:last-child { border-right: 0; }
  .m + .m { padding-left: 16px; }
  .m dd { margin: 18px 0 0; font-size: var(--step-3); font-weight: 850; line-height: 0.9; letter-spacing: -0.03em; }
  .steps { list-style: none; padding: 0; margin: clamp(56px, 7vw, 112px) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--ink); }
  .steps li { padding: 16px 20px 28px 0; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 40px 1fr; gap: 6px 8px; }
  .steps li:nth-child(3n+2), .steps li:nth-child(3n) { padding-left: 20px; border-left: 1px solid var(--line); }
  .idx { color: var(--muted); padding-top: 6px; }
  .steps h3 { font-size: var(--step-2); font-weight: 800; font-stretch: 112%; }
  .steps p { grid-column: 2; color: var(--muted); max-width: 42ch; font-size: 15.5px; }
  .stack { margin-top: 24px; color: var(--muted); }
  @media (max-width: 900px) {
    .lede, .more { grid-column: 1 / -1; justify-self: start; }
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .m:nth-child(2) { border-right: 0; }
    .m:nth-child(3) { padding-left: 0; }
    .m:nth-child(n+3) { border-top: 1px solid var(--line); margin-top: 20px; }
    .steps { grid-template-columns: 1fr; }
    .steps li:nth-child(n) { padding-left: 0; border-left: 0; }
  }
</style>
