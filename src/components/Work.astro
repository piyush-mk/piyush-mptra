---
import Kinetic from "./Kinetic.astro";
import { portbot, autowebqc } from "../content/profile";

const systems = [
  { id: "portbot", name: "PortBot", kind: "LLM agent", line: portbot.line, metrics: portbot.metrics, href: "/work/portbot" },
  { id: "autowebqc", name: "AutoWebQC", kind: "Compliance checks", line: autowebqc.line, metrics: autowebqc.metrics, href: undefined },
];
---
<section class="section" id="work" aria-labelledby="work-h">
  <div class="wrap">
    <div class="section-head">
      <span class="label">At work · BlackRock</span>
      <h2 id="work-h">Two systems I built</h2>
    </div>
    <div class="systems">
      {systems.map((s) => (
        <article class="sys">
          <p class="label">{s.kind}</p>
          <h3>{s.name}</h3>
          <p class="serif lede">{s.line}</p>
          <dl class="metrics">
            {s.metrics.map((m) => (
              <div class="m">
                <dd><Kinetic text={m.value} class="num" /></dd>
                <dt class="label">{m.label}</dt>
              </div>
            ))}
          </dl>
          {s.href && <a class="more mono" href={s.href}>How it works →</a>}
        </article>
      ))}
    </div>
    <p class="note mono">Both are internal to BlackRock, so there are no screenshots.</p>
  </div>
</section>

<style>
  .systems { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 16px clamp(24px, 4vw, 64px); }
  .sys { display: grid; align-content: start; gap: 14px; border-top: 1px solid var(--ink); padding-top: 16px; }
  h3 { font-size: var(--step-3); font-weight: 850; letter-spacing: -0.03em; line-height: 0.9; }
  .lede { font-size: var(--step-1); line-height: 1.35; max-width: 34ch; }
  .metrics { margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 16px 36px; }
  .m { display: grid; gap: 6px; }
  .m dd { margin: 0; font-size: var(--step-2); font-weight: 850; line-height: 0.9; letter-spacing: -0.02em; }
  .more { text-decoration: none; color: var(--accent); }
  .note { margin-top: 28px; color: var(--muted); }
  @media (max-width: 900px) { .systems { grid-template-columns: 1fr; gap: 40px; } }
</style>
