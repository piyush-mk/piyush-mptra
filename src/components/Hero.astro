---
import { Image } from "astro:assets";
import Kinetic from "./Kinetic.astro";
import photo from "../assets/piyush.jpg";
import { person } from "../content/profile";
---
<section class="hero" aria-labelledby="hero-name">
  <canvas class="terrain" data-contour="hero" aria-hidden="true"></canvas>
  <div class="wrap grid">
    <div class="text">
      <p class="label">{person.role} · {person.location.split(",")[0]}</p>
      <h1 id="hero-name" class="name">
        <Kinetic text={person.first.toUpperCase()} idle />
        <Kinetic text={person.last.toUpperCase()} idle />
      </h1>
      <p class="statement serif">{person.statement}</p>
      <ul class="facts">
        <li><b>BlackRock</b><span>Software engineer</span></li>
        <li><b>1,500+</b><span>users on PortBot, my agent at work</span></li>
        <li><b>Advaita</b><span>live in a Mumbai school</span></li>
      </ul>
    </div>
    <figure class="photo">
      <Image src={photo} alt="Piyush Mohapatra on a London street, smiling, with a camera in hand" widths={[360, 560, 840]} sizes="(max-width: 900px) 70vw, 32vw" loading="eager" fetchpriority="high" />
    </figure>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; }
  .terrain { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.75; }
  .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; align-items: end; padding-block: clamp(40px, 7vw, 110px) clamp(48px, 6vw, 96px); }
  .text { grid-column: 1 / span 8; display: grid; gap: clamp(20px, 3vw, 36px); }
  .name {
    display: grid; font-size: min(clamp(52px, 1rem + 6.8vw, 140px), 13vw); font-weight: 850; line-height: 0.8; letter-spacing: -0.035em;
    cursor: crosshair; user-select: none;
  }
  .name :global(.kinetic) { display: flex; }
  .statement { font-size: var(--step-2); line-height: 1.12; max-width: 20ch; }
  .facts { list-style: none; margin: 0; padding: 14px 0 0; border-top: 1px solid var(--ink); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .facts li { display: grid; gap: 2px; font-size: 14.5px; font-stretch: 92%; color: var(--muted); line-height: 1.3; }
  .facts b { color: var(--ink); font-size: var(--step-1); font-weight: 800; font-stretch: 110%; letter-spacing: -0.01em; }
  .photo { grid-column: 9 / -1; margin: 0; aspect-ratio: 4 / 5; max-width: 100%; overflow: hidden; border-radius: 4px; background: var(--paper-2); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.9); transition: filter 0.6s var(--ease), transform 0.8s var(--ease); }
  .photo:hover :global(img) { filter: saturate(1.05); transform: scale(1.02); }
  @media (max-width: 900px) {
    .text { grid-column: 1 / -1; }
    .photo { grid-column: 1 / -1; width: min(300px, 70%); }
  }
  @media (max-width: 560px) {
    .facts { grid-template-columns: 1fr; gap: 10px; }
    .facts li { grid-template-columns: 130px 1fr; column-gap: 12px; align-items: baseline; }
  }
</style>
