---
const items = [
  { href: "/#experience", label: "Experience" },
  { href: "/#work", label: "Work" },
  { href: "/#projects", label: "Projects" },
  { href: "/#contact", label: "Contact" },
];
---
<header class="nav">
  <div class="wrap row">
    <a class="mark" href="/" aria-label="Piyush Mohapatra, home">
      <span class="pm">PM</span>
      <span class="mono where">piyush-mptra.com</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>
    <button class="cmd mono" type="button" data-palette-open aria-haspopup="dialog">
      <span class="kbd">⌘K</span><span class="cmd-label">Jump to</span>
    </button>
    <button class="theme" type="button" data-theme-toggle aria-pressed="false" aria-label="Dark mode">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .row { display: flex; align-items: center; gap: 24px; height: 56px; }
  .mark { display: flex; align-items: baseline; gap: 12px; text-decoration: none; }
  .pm { font-weight: 900; font-stretch: 125%; font-size: 18px; letter-spacing: -0.02em; }
  .where { color: var(--muted); }
  nav { margin-left: auto; }
  ul { display: flex; gap: clamp(14px, 2.4vw, 32px); list-style: none; margin: 0; padding: 0; }
  ul a { text-decoration: none; font-weight: 500; font-size: 15px; font-stretch: 90%; transition: font-stretch 0.3s var(--ease); }
  ul a:hover { font-stretch: 125%; }
  .cmd {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 5px 10px;
  }
  .cmd:hover { border-color: var(--accent); color: var(--accent); }
  .kbd { font-weight: 500; }
  .theme { display: grid; place-items: center; width: 34px; height: 30px; border: 1px solid var(--line); border-radius: 6px; background: transparent; color: var(--ink); cursor: pointer; }
  .theme:hover { border-color: var(--accent); color: var(--accent); }
  .theme svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .theme .moon { display: none; }
  :global(:root[data-theme="dark"]) .theme .sun { display: none; }
  :global(:root[data-theme="dark"]) .theme .moon { display: block; }
  @media (max-width: 720px) {
    .where, .cmd-label, .cmd { display: none; }
    ul { gap: 14px; }
    ul a { font-size: 14px; }
    .row { gap: 14px; }
  }
  @media (max-width: 420px) {
    nav li:nth-child(2) { display: none; }
  }
</style>
