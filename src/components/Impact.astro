---
import { impact } from "../content/profile";
const max = Math.max(...impact.map((i) => i.hours));
const peaks = impact.map((i) => ({ ...i, h: 0.35 + 0.65 * (Math.log(i.hours) / Math.log(max)) }));
const total = impact.reduce((a, i) => a + i.hours, 0);
---
<section class="section" id="impact" aria-labelledby="impact-h">
  <div class="wrap">
    <div class="section-head">
      <span class="label">Impact map</span>
      <h2 id="impact-h">Hours handed back, drawn as terrain.</h2>
    </div>
    <div class="map">
      <figure class="plot reveal">
        <canvas data-contour="impact" data-peaks={JSON.stringify(peaks.map((p) => [p.x, p.y, p.h]))} aria-hidden="true"></canvas>
        {peaks.map((p, i) => (
          <span class="pin mono" data-pin={i} data-x={p.x} data-y={p.y}>
            <span class="tick"></span>{p.name}
          </span>
        ))}
        <figcaption class="mono legend">Peak height scales with log(hours saved per year). Contour interval is constant.</figcaption>
      </figure>
      <ol class="key">
        {peaks.map((p, i) => (
          <li data-peak={i} tabindex="0">
            <span class="nm">{p.name}</span>
            <span class="hr mono num">{p.hours.toLocaleString("en-US")} h/yr</span>
          </li>
        ))}
        <li class="sum"><span class="nm">Total, measured</span><span class="hr mono num">{total.toLocaleString("en-US")} h/yr</span></li>
      </ol>
    </div>
  </div>
</section>

<style>
  .map { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 16px 40px; align-items: end; }
  .plot { position: relative; margin: 0; aspect-ratio: 16 / 10; max-width: 100%; background: var(--paper-2); border: 1px solid var(--line); overflow: hidden; }
  .plot canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pin { position: absolute; transform: translate(-50%, -140%); white-space: nowrap; display: flex; flex-direction: column; align-items: center; gap: 4px; pointer-events: none; transition: color 0.2s; }
  .pin.on { color: var(--accent); }
  .tick { order: 2; width: 1px; height: 14px; background: currentColor; }
  .legend { position: absolute; left: 12px; bottom: 10px; right: 12px; color: var(--muted); }
  .key { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .key li { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); cursor: default; transition: padding 0.3s var(--ease), color 0.2s; }
  .key li:not(.sum):hover, .key li:focus-visible, .key li.on { color: var(--accent); padding-left: 10px; }
  .nm { font-size: var(--step-1); font-weight: 700; font-stretch: 105%; }
  .sum { border-bottom: 2px solid var(--ink) !important; }
  .sum .nm { font-weight: 500; font-stretch: 85%; }
  @media (max-width: 900px) { .map { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .pin { font-size: 10px; } .legend { display: none; } }
</style>
