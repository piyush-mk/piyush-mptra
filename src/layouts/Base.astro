---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Palette from "../components/Palette.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Piyush Mohapatra · Software Engineer",
  description = "Software engineer at BlackRock, building software people rely on, from finance systems to classrooms.",
} = Astro.props;
// Pages build as /name.html; the public URL drops the extension and the index name
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4f5f2" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Piyush Mohapatra" />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Piyush Mohapatra, Software Engineer at BlackRock" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og.jpg", Astro.site).href} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline>(function(){try{if(localStorage.getItem("theme")==="dark")document.documentElement.dataset.theme="dark"}catch(e){}document.documentElement.classList.add("js")})();</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Palette />
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: 12px; top: -48px; z-index: 100; background: var(--ink); color: var(--paper); padding: 8px 12px; font-family: var(--f-mono); font-size: 13px; }
  .skip:focus { top: 12px; }
</style>
