{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piyush-mptra",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "piyush-mptra.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "piyush_mptra_events" }],
  "observability": { "enabled": true }
}
